<Project>
  <!-- Keep bin/obj out of the source tree (Tools~/autobahn) and inside the ignored .build folder. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../.build/autobahn/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../.build/autobahn/bin/</BaseOutputPath>
  </PropertyGroup>
</Project>
