<Project>
  <!-- Keep bin/obj out of the source tree (Tools~/fuzz) and inside the ignored .build folder. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../.build/fuzz/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../.build/fuzz/bin/</BaseOutputPath>
  </PropertyGroup>
</Project>
