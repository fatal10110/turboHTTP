<Project>
  <!-- Keep bin/obj out of the source tree (Tools~/bench) and inside the ignored .build folder. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../.build/bench/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../.build/bench/bin/</BaseOutputPath>
  </PropertyGroup>
</Project>
