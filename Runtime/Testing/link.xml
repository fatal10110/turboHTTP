<linker>
  <!--
    RecordReplayTransport hashing path (SHA-256).
    Preserve providers used by SHA256.Create() on Unity/IL2CPP profiles. SHA256 and
    SHA256Managed are implemented in mscorlib, SHA256CryptoServiceProvider in System.Core.
  -->
  <assembly fullname="mscorlib">
    <type fullname="System.Security.Cryptography.SHA256" preserve="all" />
    <type fullname="System.Security.Cryptography.SHA256Managed" preserve="all" />
  </assembly>
  <assembly fullname="System.Core">
    <type fullname="System.Security.Cryptography.SHA256CryptoServiceProvider" preserve="all" />
  </assembly>
</linker>
