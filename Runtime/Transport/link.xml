<linker>
  <!--
    SslStream ALPN types (SslStreamTlsProvider.BuildAlpnOptions and the ALPN handshake:
    SslClientAuthenticationOptions, ApplicationProtocols, SslApplicationProtocol.Http2/Http11,
    AuthenticateAsClientAsync(options, CancellationToken), NegotiatedApplicationProtocol).
    The provider calls them statically (no reflection since #303), so the linker already keeps
    what it uses; these rules stay as defense in depth. If the options cannot be built at run
    time, the provider falls back to a handshake without ALPN (http/1.1 offered) and HTTP/2 is
    never negotiated over SslStream.
    On Unity 2021.3 Mono/IL2CPP (unityaot and unityjit profiles) these types are implemented in
    System.dll; System.Net.Security.dll is only a .NET Standard facade that forwards to it, so the
    rule must name "System" (#35). No facade is named: a facade is not in a player build unless
    something references it, and preserving a forwarded type there keeps nothing.
  -->
  <assembly fullname="System">
    <type fullname="System.Net.Security.SslStream" preserve="all"/>
    <type fullname="System.Net.Security.SslClientAuthenticationOptions" preserve="all"/>
    <type fullname="System.Net.Security.SslApplicationProtocol" preserve="all"/>
  </assembly>

  <!--
    Generic templates for IL2CPP/AOT. List<SslApplicationProtocol> is instantiated by a static
    call site in SslStreamTlsProvider.BuildAlpnOptions (#303), which is what makes IL2CPP generate
    its AOT code; preserving the open List<> template keeps its members against stripping.
    UnityLinker matches open generic type names only; closed instantiations such as
    ValueTask`1[[...]] are ignored, so only the open templates are listed.
  -->
  <assembly fullname="mscorlib">
    <type fullname="System.Collections.Generic.List`1" preserve="all"/>
    <type fullname="System.Threading.Tasks.Sources.ManualResetValueTaskSourceCore`1" preserve="all"/>
  </assembly>

  <!--
    22a.1 HTTP/2 receive-queue primitive used by the streaming design.
    Preserve the generic channel template so IL2CPP keeps its async-waiter methods.
    Transport registration: the TurboHttpBootstrap RuntimeInitializeOnLoadMethod (TurboHTTP.Complete,
    [Preserve]) calls RawSocketTransport.EnsureRegistered statically. TransportModuleInitializer is
    the secondary path for runtimes that run module initializers; nothing references it statically.
  -->
  <assembly fullname="TurboHTTP.Transport">
    <type fullname="TurboHTTP.Transport.Http2.SingleReaderChannel`1" preserve="all"/>
    <type fullname="TurboHTTP.Transport.Http2.Http2ResponseBodySource" preserve="all"/>
    <type fullname="TurboHTTP.Transport.TransportModuleInitializer" preserve="all"/>
    <type fullname="TurboHTTP.Transport.RawSocketTransport" preserve="all"/>
  </assembly>
</linker>
