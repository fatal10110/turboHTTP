<linker>
  <!--
    BouncyCastle TLS provider: the glue (TurboHTTP.Transport.BouncyCastle) and the vendored
    BouncyCastle library it compiles against (TurboHTTP.SecureProtocol, Lib/ with its own asmdef).
    Preserve both assemblies entirely because:
    1. Entry point (BouncyCastleTlsProvider) is loaded via reflection
    2. BC internally resolves algorithms by string OIDs (e.g. "AES/GCM/NoPadding"),
       so the linker can't statically trace all code paths
    3. Can be narrowed to specific ciphers later for size optimization
    This file lives in the BouncyCastle folder (owned by the glue asmdef, not in Lib/, which the
    upstream re-vendor sync replaces wholesale) so that TurboHttpLinkerProcessor passes it to
    UnityLinker only when the TurboHTTP.Transport.BouncyCastle assembly is part of the build.
  -->
  <assembly fullname="TurboHTTP.Transport.BouncyCastle" preserve="all"/>
  <assembly fullname="TurboHTTP.SecureProtocol" preserve="all"/>
</linker>
