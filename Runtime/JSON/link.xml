<linker>
  <!--
    No TurboHTTP assembly looks these types up by name any more: TurboHTTP.JSON registers itself
    with TurboHTTP.Core.ProjectJsonBridge (JsonModuleRegistration, called by the TurboHTTP.Complete
    bootstrap), and Auth, Testing, Unity and WebSocket call it through that registration.
    The public serializer API stays preserved so application code reached only through
    reflection or serialized references keeps working under High stripping.
  -->
  <assembly fullname="TurboHTTP.JSON">
    <type fullname="TurboHTTP.JSON.JsonExtensions" preserve="all" />
    <type fullname="TurboHTTP.JSON.JsonSerializer" preserve="all" />
  </assembly>
</linker>
